digraph N { rankdir=TB; node [fontname="DejaVu Sans Mono", fontsize=11, shape=record, style=filled, fillcolor="#f4f8ff"];
T [label="{timetable : dict|<a> \"12624\"|\"12007\"|... }"];
R [label="{train record : dict|<n> \"name\" : str|<s> \"stops\" : list|<d> \"days\" : set}"];
S [label="{stops : list|<s0> [0] tuple|<s1> [1] tuple|<s2> [2] tuple|[3] tuple}", fillcolor="#fff4d6"];
